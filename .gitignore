# macOS
.DS_Store

# preflight reports are per-machine, per-moment evidence — keep them out of the
# methodology repo. Write them outside the checkout (--out ../preflight-<date>.md)
# and paste the interesting parts into a doc if they matter.
preflight-*.md
preflight.md

# lane runtime artifacts (worktrees, logs) must never enter the forge repo
.worktrees/
*.log

# per-machine permission grants. `.claude/settings.json` IS shared — it carries
# the repo's own read-only tooling (verify/preflight/metrics). The .local file
# is whatever this particular machine happened to approve, and is not methodology.
.claude/settings.local.json

# per-run exhaust written by /end-chunk and the lane (chunk metadata, PR bodies).
# Same rule the staged run guide puts on every product: run evidence is real, and
# it does not belong in the methodology repo.
.forge/
